{
 "id": "run_3f2a9c",
 "title": "Core switch migration — Legacy v4 → NewSwitch v1",
 "status": "awaiting_approval",
 "created_at": "2026-09-27T16:02:11Z",
 "requirements": [
  "Approve a purchase when funds are available",
  "Decline a purchase for insufficient funds",
  "Reject a duplicate purchase (same card, STAN and amount within 60 seconds)",
  "Reverse an approved payment and restore the balance"
 ],
 "rules_text": "Legacy v4 checks every 0100/0200 in this order: unknown card -> 14; blocked card -> 62; expired card -> 54; incorrect PIN -> 55; issuer glitch -> 96; duplicate (same card, STAN and amount within 60 seconds) -> 94; balance below amount -> 51; otherwise approve 00 and debit. 0400 reversals: original not found or not approved -> 25; already reversed -> 94; otherwise credit back 00.",
 "spec_text": "ISO 8583 (ASCII). MTI 0100 auth, 0200 purchase, 0400 reversal. Fields: 2 card number, 3 processing code, 4 amount (12 digits, cents), 7 transmission time MMDDhhmmss, 11 STAN, 14 expiry YYMM, 18 MCC, 22 entry mode, 37 retrieval ref, 39 response code, 41 terminal id, 48 private data, 49 currency (840 = USD).",
 "bounds": {
  "max_amount_cents": 100000,
  "allowed_mti": [
   "0100",
   "0200",
   "0400"
  ],
  "auto_followups": true
 },
 "replay": {
  "enabled": false,
  "sample_size": 2000,
  "dataset": "tabformer"
 },
 "plan": [
  {
   "rule": "approve_purchase",
   "description": "Approve a purchase when funds are available",
   "states": [
    "active card, balance > amount",
    "balance == amount"
   ]
  },
  {
   "rule": "decline_insufficient",
   "description": "Decline a purchase for insufficient funds",
   "states": [
    "amount > balance",
    "balance drained by an earlier purchase"
   ]
  },
  {
   "rule": "reject_duplicate",
   "description": "Reject a duplicate purchase (same card, STAN and amount within 60 seconds)",
   "states": [
    "retry at +5 s",
    "same STAN, different amount",
    "retry at +61 s"
   ]
  },
  {
   "rule": "reverse_approved",
   "description": "Reverse an approved payment and restore the balance",
   "states": [
    "reverse approved purchase",
    "double reversal",
    "unknown original"
   ]
  }
 ],
