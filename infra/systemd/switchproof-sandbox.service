[Unit]
Description=SwitchProof sandbox host (runs approved tests in gVisor sandboxes)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
User=switchproof
Group=switchproof
SupplementaryGroups=docker kvm
WorkingDirectory=/opt/switchproof
EnvironmentFile=/etc/switchproof.env
Environment=SANDBOX_MODE=gvisor
# BIND_IP is the VPC (or NetBird) address from /etc/switchproof.env; never 0.0.0.0
ExecStart=/opt/switchproof/.venv/bin/uvicorn sandbox_host.app:app --host ${BIND_IP} --port 9000
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
